<?xml version="1.0"?>
<!-- Deterministic shadow-demo scene: a box elevated a metre above the ground so a
     directional key light casts a clear shadow onto the solid grid floor. Used by
     the scene3d_mesh_viewer shadow flag for A/B screenshots. -->
<robot name="shadow_demo">
  <link name="base_link"/>
  <link name="box">
    <visual>
      <origin xyz="0 0 1.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.6 0.6 0.6"/>
      </geometry>
      <material name="blue">
        <color rgba="0.30 0.50 0.90 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="base_to_box" type="fixed">
    <parent link="base_link"/>
    <child link="box"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
